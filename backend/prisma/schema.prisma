// ==========================================
// Módulo 1: Gestión de clientes y expedientes
// ==========================================

generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../modelo_datos.svg"
  disableEmoji = true
  theme = "neutral"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------
// TIPO DE CLIENTE
// Enum para distinguir física/jurídica sin usar strings sueltos
// (evita typos como "Fisica" vs "FISICA" en distintas partes del código)
// ------------------------------------------
enum TipoCliente {
  FISICA
  JURIDICA
}

// ------------------------------------------
// TIPO DE ATENCIÓN
// Distingue si el cliente es judicial, extrajudicial, o ambos
// (según el anteproyecto: separar juicios de trámites/asesoría continua)
// ------------------------------------------
enum TipoAtencion {
  JUDICIAL
  EXTRAJUDICIAL
  AMBOS
}

// ------------------------------------------
// FUERO
// Define el área jurisdiccional del expediente.
// Convertido a enum (antes era String libre) porque determina
// qué roles de ParteProcesal son válidos y si aplican
// montoJuicio / unidadFiscal.
// ------------------------------------------
enum Fuero {
  CIVIL_COMERCIAL
  LABORAL
  PENAL
  NINEZ_ADOLESCENCIA
  CONTENCIOSO_ADMINISTRATIVO
  OTRO
}

// ------------------------------------------
// ESTADO PROCESAL
// Situación actual del expediente dentro del proceso judicial.
// Es enum (no texto libre) para evitar variantes como
// "En trámite" / "en tramite" que romperían los filtros.
// Agregar un valor nuevo a futuro = una migración chica.
// ------------------------------------------
enum EstadoProcesal {
  EN_TRAMITE
  EN_APELACION
  SUSPENDIDO
  ARCHIVADO
  CONCLUIDO
}

// ------------------------------------------
// ROL DE PARTE PROCESAL
// Categorías amplias y estables, independientes del fuero.
// El matiz exacto (Actor, Imputado, Víctima...) va en
// ParteProcesal.rolEspecifico como texto libre.
// ------------------------------------------
enum RolParte {
  ACTOR                   // actor / demandante / solicitante / denunciante / víctima
  DEMANDADO               // demandado / imputado / acusado
  TERCERO                 // tercero / citado en garantía / querellante adhesivo
  REPRESENTANTE_ESTATAL   // agente fiscal (Ministerio Público)
  DEFENSA                 // defensor técnico (privado o público)
}

// ------------------------------------------
// CLIENTE (tabla base)
// Contiene los datos comunes a persona física y jurídica.
// Las extensiones (ClientePersonaFisica / ClientePersonaJuridica)
// cuelgan de esta tabla en relación 1:1.
// ------------------------------------------
model Cliente {
  id              Int           @id @default(autoincrement())
  ruc             String        @unique // RUC: en física es cédula + dígito verificador, en jurídica es el RUC societario
  tipo            TipoCliente
  nombreRazonSocial String      // nombre completo (física) o razón social (jurídica)
  tipoAtencion    TipoAtencion  @default(JUDICIAL)
  email           String?
  telefono        String?
  direccion       String?
  activo          Boolean       @default(true) // permite "dar de baja" sin borrar el historial
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relaciones 1:1 con las extensiones (una y solo una debe existir según 'tipo')
  personaFisica   ClientePersonaFisica?
  personaJuridica ClientePersonaJuridica?

  // Relación 1:N: un cliente puede tener muchos expedientes
  expedientes     Expediente[]
  partesProcesales ParteProcesal[]  // NUEVO: casos donde este cliente es parte de un expediente (propio o ajeno)

  obligaciones  ObligacionPeriodica[]   // Módulo 1.3
  tramites      Tramite[]               // Módulo 1.3
  cobros        Cobro[]                 // (Módulo 4): recibos de cobro emitidos a este cliente
  @@map("clientes") // nombre real de la tabla en PostgreSQL (snake_case, convención SQL)
}

// ------------------------------------------
// EXTENSIÓN: PERSONA FÍSICA
// Datos exclusivos de clientes persona física.
// clienteId es a la vez FK y PK: garantiza la relación 1:1
// (un Cliente no puede tener dos registros de PersonaFisica)
// ------------------------------------------
model ClientePersonaFisica {
  clienteId               Int      @id
  cliente                 Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  cedula                  String   @unique
  digitoVerificador       Int      // dígito verificador del RUC, define condiciones (ej. vencimientos)
  fechaNacimiento          DateTime?

  @@map("clientes_persona_fisica")
}

// ------------------------------------------
// EXTENSIÓN: PERSONA JURÍDICA
// Datos básicos por ahora (según alcance actual).
// A futuro: representantes, actas de asamblea, estatutos, libro de acciones
// (mencionado por la clienta pero fuera del alcance de esta versión).
// ------------------------------------------
model ClientePersonaJuridica {
  clienteId         Int      @id
  cliente           Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  tipoSocietario    String   // ej. "SA", "SRL", "Fundación" — texto libre por ahora, no enum (puede variar mucho)
  fechaConstitucion DateTime?
  representanteLegal String? // NUEVO: quien representa a la empresa en general. Texto simple y opcional; si a futuro se necesita como entidad (con CI, poder, etc.), se migra a tabla propia.

  @@map("clientes_persona_juridica")
}

// ------------------------------------------
// EXPEDIENTE
// Registro de casos judiciales y extrajudiciales.
// El monto del juicio es opcional porque no todo expediente lo tiene
// (ej. trámites o asesorías sin monto litigioso definido).
//
// IDENTIFICACIÓN ÚNICA (regla de negocio validada con la abogada):
// en Paraguay el número de expediente NO es único por sí solo:
// la numeración reinicia cada año y un expediente puede trasladarse
// a otro juzgado. Por eso se identifica por la combinación
// número + año + juzgado + carátula (ver @@unique al final).
// ------------------------------------------
model Expediente {
  id              Int       @id @default(autoincrement())
  clienteId       Int
  cliente         Cliente   @relation(fields: [clienteId], references: [id])

  numeroExpediente String   // ya NO es @unique solo: la unicidad es compuesta (ver abajo)
  anio            Int       // NUEVO: año del expediente (la numeración reinicia cada año). Ej: 2024
  caratula        String
  fuero           Fuero?
  jurisdiccion    String?
  juzgado         String    // CAMBIO: ahora obligatorio. Sin juzgado no se puede validar duplicados.
  secretaria      String?   // Secretaría del juzgado (ej. "Secretaría N°1")
  objetoJuicio    String?   // descripción breve del tipo de proceso (ej. "Cobro de Guaraníes", "Sucesión Intestada")
  montoJuicio     Decimal?  @db.Decimal(15, 2) // 15 dígitos en total, 2 decimales. Opcional: no aplica en fueros como Penal
  unidadFiscal    String?   // exclusivo de fuero Penal (ej. "Unidad Penal N°5"). Null en otros fueros.
  estadoProcesal  EstadoProcesal @default(EN_TRAMITE) // NUEVO: situación procesal actual

  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relación 1:N con las partes procesales del expediente
  partes          ParteProcesal[]

  // Unicidad compuesta: mismo número + año + juzgado + carátula = duplicado.
  // Si cambia cualquiera de los cuatro, se considera un expediente distinto.
  @@unique([numeroExpediente, anio, juzgado, caratula])

  documentosRecibidos DocumentoRecibido[]   // Módulo 1.3
  actuaciones     Actuacion[] // (Módulo 2): historial de actuaciones registradas sobre este expediente
  plazosJudiciales PlazoJudicial[]
  liquidaciones   LiquidacionHonorarios[] // (Módulo 3): honorarios liquidados sobre este expediente
  gastos          GastoReembolsable[]     // (Módulo 3): gastos adelantados en este expediente
  cobros          Cobro[]                 // (Módulo 4): recibos de cobro de este expediente
  @@map("expedientes")
}

// ------------------------------------------
// PARTE PROCESAL
// Representa a cada sujeto involucrado en un expediente.
// Puede o no estar vinculada a un Cliente existente:
// si la parte contraria no es cliente del estudio,
// clienteId queda null y se guardan nombre/documento sueltos.
// ------------------------------------------
model ParteProcesal {
  id              Int         @id @default(autoincrement())

  expedienteId    Int
  expediente      Expediente  @relation(fields: [expedienteId], references: [id], onDelete: Cascade)

  // Vínculo opcional: si esta parte ya es Cliente del estudio, se conecta acá
  clienteId       Int?
  cliente         Cliente?    @relation(fields: [clienteId], references: [id])

  // Datos propios de la parte (se completan siempre, sea o no Cliente)
  nombre          String
  documento       String?     // CI/RUC del tercero; puede ser null si no se conoce aún

  rol             RolParte    // categoría amplia (ACTOR, DEMANDADO, etc.)
  rolEspecifico   String?     // etiqueta exacta según fuero (ej. "Imputado", "Víctima", "Actor")

  createdAt       DateTime    @default(now())

  actuaciones     Actuacion[] // (Módulo 2): actuaciones donde esta parte figura como quien presentó/notificó

  @@map("partes_procesales")
}

// ------------------------------------------
// ROL DE USUARIO
// Define el nivel de acceso dentro del sistema.
// ABOGADO: acceso total (crear/editar/eliminar en todos los módulos).
// ASISTENTE: por ahora solo lectura + reportes (se resuelve en el
// middleware de autorización, no acá — así cambiar permisos más
// adelante no requiere tocar el schema ni migrar la DB).
// ------------------------------------------
enum RolUsuario {
  ABOGADO
  ASISTENTE
}

// ------------------------------------------
// USER (Usuario del sistema)
// No hay auto-registro público: la abogada (ABOGADO) crea las
// cuentas de sus asistentes desde el módulo "Gestión de usuarios".
// Hay un único ABOGADO; puede haber varios ASISTENTE.
// ------------------------------------------
model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String     // solo el hash (bcrypt), nunca la contraseña en texto plano
  nombre       String
  rol          RolUsuario @default(ASISTENTE)
  activo       Boolean    @default(true) // desactivar acceso sin borrar historial

  // true = la contraseña actual es temporal (recién creada o reseteada
  // por la abogada) y el usuario DEBE cambiarla antes de usar el sistema.
  debeCambiarPassword Boolean @default(true)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  auditorias   Auditoria[]   // historial de acciones de este usuario
  cobrosCreados  Cobro[] @relation("CobroCreadoPor")   // (Módulo 4): recibos emitidos por este usuario
  cobrosAnulados Cobro[] @relation("CobroAnuladoPor")  // (Módulo 4): recibos anulados por este usuario

  @@map("users")
}

// ============================================================
// MÓDULO 1.4 — BIBLIOTECA DE ESCRITOS FORENSES
// Plantillas de escritos que se van "catastrando" de a poco.
// Cuerpo en texto plano (sin variables). Hard-delete (sin campo activo).
// ============================================================

// Clasificación de primer nivel, como la organiza la abogada
enum ClaseEscrito {
  DE_FONDO          // escritos principales: demanda, excepción, contestación
  DE_MERO_TRAMITE   // impulso, oficios, denuncias, etc.
}

// Tipo específico de escrito
enum CategoriaEscrito {
  DEMANDA
  CONTESTACION
  EXCEPCION
  RECURSO
  IMPULSO_PROCESAL
  SOLICITUD_OFICIO
  DENUNCIA
  MEDIACION
  MEDIDA_CAUTELAR
  OTRO
}

// De dónde salió el texto (trazabilidad: propia, generada con IA u otro)
enum OrigenPlantilla {
  PROPIA
  IA
  OTRO
}

model PlantillaEscrito {
  id            Int              @id @default(autoincrement())
  titulo        String           @db.VarChar(200)   // nombre visible en la lista
  descripcion   String?          @db.VarChar(300)   // resumen corto (opcional)
  contenido     String           @db.Text           // cuerpo completo del escrito (texto plano, sin límite práctico)

  fuero         Fuero?                              // reutiliza el enum existente; opcional (hay escritos válidos para cualquier fuero)
  clase         ClaseEscrito                        // obligatoria: de fondo o de mero trámite
  categoria     CategoriaEscrito                    // obligatoria: tipo específico
  origen        OrigenPlantilla  @default(PROPIA)   // por defecto se asume propia

  creadoEn      DateTime         @default(now())    // se completa solo al crear
  actualizadoEn DateTime         @updatedAt         // Prisma lo actualiza solo en cada edición

  @@index([fuero, clase, categoria])                // acelera los filtros combinados de la pantalla
}

// ============================================================
// MÓDULO 1.3 — ASESORÍAS CONTABLES Y TRÁMITES
// Catálogo de trámites -> obligaciones periódicas -> vencimientos (Tramite)
// + registro de recepción de documentos.
// Las fechas de vencimiento se guardan como @db.Date (solo día, sin hora).
// ============================================================

// Cada cuánto se repite una obligación periódica
enum PeriodicidadTramite {
  MENSUAL   // vence todos los meses (día según terminación de RUC)
  ANUAL     // vence una vez al año, en el mes elegido (mesAnual)
}

// Estado de un vencimiento/trámite (confirmados por la abogada)
enum EstadoTramite {
  PENDIENTE
  EN_PROCESO
  PRESENTADO
  FINALIZADO
}

// ------------------------------------------------------------
// CATÁLOGO DE TIPOS DE TRÁMITE ("catastrar" un trámite una sola vez)
// Si ya tiene trámites asociados no se borra: se inactiva (activo = false).
// ------------------------------------------------------------
model TipoTramite {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique @db.VarChar(120)   // ej: "IVA general" (único en el catálogo)
  descripcion   String?  @db.VarChar(300)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  obligaciones  ObligacionPeriodica[]
  tramites      Tramite[]
}

// ------------------------------------------------------------
// OBLIGACIÓN PERIÓDICA: "a este cliente le presento este trámite
// todos los meses / todos los años". Genera los vencimientos.
// Inactivarla (activa = false) frena la generación futura y
// conserva el historial.
// ------------------------------------------------------------
model ObligacionPeriodica {
  id             Int                 @id @default(autoincrement())
  clienteId      Int
  cliente        Cliente             @relation(fields: [clienteId], references: [id])
  tipoTramiteId  Int
  tipoTramite    TipoTramite         @relation(fields: [tipoTramiteId], references: [id])

  periodicidad   PeriodicidadTramite
  mesAnual       Int?                // 1 a 12; solo se usa si es ANUAL (mes en que vence cada año)
  observaciones  String?             @db.VarChar(300)
  activa         Boolean             @default(true)
  creadoEn       DateTime            @default(now())
  actualizadoEn  DateTime            @updatedAt

  tramites       Tramite[]

  @@index([clienteId])
}

// ------------------------------------------------------------
// TRÁMITE = un vencimiento concreto con su estado.
//  - Único: obligacionId = null, fecha cargada a mano.
//  - Periódico: lo genera el sistema desde una ObligacionPeriodica.
// El calendario del Módulo 2 lee esta misma tabla.
// ------------------------------------------------------------
model Tramite {
  id               Int                  @id @default(autoincrement())
  clienteId        Int
  cliente          Cliente              @relation(fields: [clienteId], references: [id])
  tipoTramiteId    Int
  tipoTramite      TipoTramite          @relation(fields: [tipoTramiteId], references: [id])

  obligacionId     Int?                 // null = trámite único (puntual)
  obligacion       ObligacionPeriodica? @relation(fields: [obligacionId], references: [id])
  periodo          String?              @db.VarChar(7)   // "AAAA-MM" del mes de vencimiento; solo en los generados

  fechaVencimiento DateTime             @db.Date         // solo fecha, sin hora
  estado           EstadoTramite        @default(PENDIENTE)
  descripcion      String?              @db.VarChar(300)
  creadoEn         DateTime             @default(now())
  actualizadoEn    DateTime             @updatedAt

  documentos       DocumentoRecibido[]

  liquidaciones    LiquidacionHonorarios[] // (Módulo 3): honorarios liquidados sobre este trámite
  gastos           GastoReembolsable[]     // (Módulo 3): gastos adelantados en este trámite
  cobros           Cobro[]                 // (Módulo 4): recibos de cobro de este trámite

  // Evita generar dos veces el mismo período de una obligación.
  // (Postgres trata los NULL como distintos: los trámites únicos no chocan entre sí.)
  @@unique([obligacionId, periodo])
  @@index([clienteId])
  @@index([fechaVencimiento])
  @@index([estado])
}

// ------------------------------------------------------------
// DOCUMENTO RECIBIDO: registro de recepción (NO guarda archivos).
// Va enganchado a un trámite (documentos contables) O a un
// expediente (documentos de juicios): uno de los dos, nunca ambos.
// Esa regla la valida el service (Prisma no tiene CHECK).
// onDelete: Restrict = no se puede borrar un trámite/expediente
// que tenga documentos registrados.
// ------------------------------------------------------------
model DocumentoRecibido {
  id             Int         @id @default(autoincrement())
  tramiteId      Int?
  tramite        Tramite?    @relation(fields: [tramiteId], references: [id], onDelete: Restrict)
  expedienteId   Int?
  expediente     Expediente? @relation(fields: [expedienteId], references: [id], onDelete: Restrict)

  tipoDocumento  String      @db.VarChar(150)   // ej: "Facturas de compras", "Cédula"
  fechaRecepcion DateTime    @db.Date
  observaciones  String?     @db.VarChar(500)
  creadoEn       DateTime    @default(now())

  @@index([tramiteId])
  @@index([expedienteId])
}

// ============================================================
// MÓDULO 2 — Actuaciones y plazos procesales
// ============================================================

// Enum: clasifica el tipo de acto procesal registrado.
// OTRO actúa como válvula de escape para casos no previstos
// (agregar un valor nuevo acá es una migración simple, a
// diferencia de un catálogo de tabla).
enum TipoActuacion {
  PROVIDENCIA
  RESOLUCION
  SENTENCIA
  ESCRITO_PRESENTADO
  AUDIENCIA
  NOTIFICACION
  OFICIO
  OTRO
}

// Modelo: registro cronológico de todo lo que ocurre en un expediente
// (providencias, resoluciones, escritos, audiencias, etc.).
// Es la base de RF5; desde una actuación con fecha de notificación
// se puede generar un PlazoJudicial (RN-20, próximo paso).
model Actuacion {
  id              Int            @id @default(autoincrement())

  // FK obligatoria: toda actuación pertenece a un expediente.
  expedienteId    Int
  expediente      Expediente     @relation(fields: [expedienteId], references: [id], onDelete: Restrict)

  // FK opcional: quién presentó/notificó, si corresponde.
  // onDelete: SetNull porque ParteProcesal es hard-delete (Módulo 1) —
  // si se borra la parte por error, la actuación no debe desaparecer
  // ni bloquear el borrado.
  parteProcesalId Int?
  parteProcesal   ParteProcesal? @relation(fields: [parteProcesalId], references: [id], onDelete: SetNull)

  tipo            TipoActuacion

  // Fecha en que ocurrió el acto procesal (providencia dictada,
  // escrito presentado, etc.) — no confundir con fechaNotificacion.
  fecha           DateTime       @db.Date

  descripcion     String         @db.Text

  // Fecha desde la cual se tiene por notificada la actuación
  // (RN-20: hito que origina el cómputo de un plazo). Opcional
  // porque no toda actuación implica notificación formal.
  fechaNotificacion DateTime?    @db.Date

  creadoEn        DateTime       @default(now())
  actualizadoEn   DateTime       @updatedAt

  plazos          PlazoJudicial[]
  // Orden cronológico descendente es el uso principal en la ficha
  // del expediente — este índice lo acelera.
  @@index([expedienteId, fecha])

  @@map("actuaciones")
}

// ============================================================
// MÓDULO 2 — Catálogos de plazos (TipoPlazo, DiaNoHabil)
// Van antes de PlazoJudicial porque este último depende de ambos.
// ============================================================

// ------------------------------------------------------------
// MODALIDAD DE CÓMPUTO DEL PLAZO
// HABILES  → cuenta solo días hábiles (excluye fines de semana y
//            los DiaNoHabil cargados). Uso típico: fuero civil/laboral.
// CORRIDOS → cuenta todos los días calendario sin excepción.
//            Uso típico: fuero penal por defecto (RN-19).
// HORAS    → no se calcula: la abogada carga directamente la fecha
//            y hora límite (frecuente en fuero penal, 24-48hs).
// ------------------------------------------------------------
enum ModalidadPlazo {
  HABILES
  CORRIDOS
  HORAS
}

// ------------------------------------------------------------
// FUERO APLICABLE (solo para TipoPlazo)
// Enum SEPARADO del enum Fuero que usa Expediente/PlantillaEscrito.
// Motivo: agregar TODOS acá no debe habilitar ese valor en
// Expediente.fuero (un juicio real es de un solo fuero concreto).
// Al ser un enum distinto, la base de datos hace estructuralmente
// imposible que Expediente.fuero valga TODOS, sin depender de que
// el código de la aplicación lo valide correctamente siempre.
// ------------------------------------------------------------
enum FueroAplicable {
  CIVIL_COMERCIAL
  LABORAL
  PENAL
  NINEZ_ADOLESCENCIA
  CONTENCIOSO_ADMINISTRATIVO
  OTRO
  TODOS   // el tipo de plazo se sugiere sin importar el fuero del expediente
}

// ------------------------------------------------------------
// CATÁLOGO DE TIPOS DE PLAZO
// Ej: "Contestación de demanda civil" (18 días hábiles),
// "Contestación laboral" (6 días hábiles), etc. — mismos plazos
// que dio la abogada, uno por fila (no se comparte fila entre fueros
// aunque el nombre se parezca, porque los días default difieren).
//
// diasDefault y modalidadDefault son SUGERENCIAS: al cargar un
// PlazoJudicial concreto, la abogada puede cambiar ambos valores
// para ese caso puntual (RN-19: en penal a veces cambia de corridos
// a horas según la actuación). El catálogo no impone una regla
// rígida, solo evita empezar de cero cada vez.
//
// Mismo patrón que TipoTramite: no se borra si tiene plazos
// asociados, se inactiva.
// ------------------------------------------------------------
model TipoPlazo {
  id                Int             @id @default(autoincrement())
  nombre            String          @db.VarChar(150)   // ej: "Contestación de demanda civil"
  fuero             FueroAplicable  @default(TODOS)
  diasDefault       Int                                 // sugerencia de cantidad (18, 6, 5, 3...)
  modalidadDefault  ModalidadPlazo  @default(HABILES)
  activo            Boolean         @default(true)
  creadoEn          DateTime        @default(now())
  actualizadoEn     DateTime        @updatedAt

  plazos            PlazoJudicial[]

  // Mismo nombre puede repetirse para distinto fuero (son filas
  // distintas a propósito), pero no dos veces para el MISMO fuero.
  @@unique([nombre, fuero])
  @@map("tipos_plazo")
}

// ------------------------------------------------------------
// DÍAS NO HÁBILES
// Una sola tabla para feriados nacionales, asuetos locales y feria
// judicial (RN-23: se cargan a nivel nacional; asuetos locales se
// ajustan manualmente) — la diferencia está en QUIÉN carga cada
// fila y CUÁNDO (seed anual vs carga manual puntual), no en la
// estructura: ambas son simplemente "un día que no cuenta para
// el cómputo de plazos en días hábiles".
//
// fechaHasta permite cargar un RANGO de una sola vez (ej. feria
// judicial 1 al 31 de enero) sin crear 31 filas sueltas.
// Un feriado de un solo día deja fechaHasta = null (o igual a
// fechaDesde).
// ------------------------------------------------------------
model DiaNoHabil {
  id           Int       @id @default(autoincrement())
  fechaDesde   DateTime  @db.Date
  fechaHasta   DateTime? @db.Date   // null = es un solo día (fechaDesde)
  descripcion  String    @db.VarChar(200)   // ej: "Feria judicial de enero", "Asueto local Encarnación"
  creadoEn     DateTime  @default(now())

  @@index([fechaDesde])
  @@map("dias_no_habiles")
}

// ============================================================
// MÓDULO 2 — PlazoJudicial (núcleo de RF6)
// El semáforo (verde/amarillo/rojo/vencido) NO se guarda como
// campo: se calcula al vuelo en el service, comparando hoy con
// fechaVencimiento, cada vez que se consulta. Así nunca queda
// desactualizado (mismo criterio que ya usás en calendarioRuc.js
// para las fechas: se calcula cuando hace falta, no se persiste
// un resultado que puede quedar viejo).
// ============================================================

enum EstadoPlazo {
  PENDIENTE
  CUMPLIDO
}

model PlazoJudicial {
  id                Int             @id @default(autoincrement())

  expedienteId      Int
  expediente        Expediente      @relation(fields: [expedienteId], references: [id], onDelete: Restrict)

  actuacionId       Int?
  actuacion         Actuacion?      @relation(fields: [actuacionId], references: [id], onDelete: SetNull)

  tipoPlazoId       Int
  tipoPlazo         TipoPlazo       @relation(fields: [tipoPlazoId], references: [id])

  diasCantidad      Int
  modalidad         ModalidadPlazo

  fechaNotificacion DateTime        @db.Date
  fechaVencimiento  DateTime        @db.Date
  horaLimite        DateTime?

  estado            EstadoPlazo     @default(PENDIENTE)
  fechaCumplido     DateTime?

  observaciones     String?         @db.VarChar(300)

  creadoEn          DateTime        @default(now())
  actualizadoEn     DateTime        @updatedAt

  @@index([estado, fechaVencimiento])
  @@index([expedienteId])
  @@map("plazos_judiciales")
}
 
// ============================================================
// MÓDULO 3 — Honorarios y gastos reembolsables (RF7 / RF8)
// Moneda: guaraníes. Los montos usan Decimal(15,2) igual que
// Expediente.montoJuicio (15 dígitos en total, 2 decimales), aunque
// el cálculo los redondea al guaraní entero (ver calculoHonorarios.js).
// Los cobros y recibos (RF10) son del Módulo 4: acá solo queda el
// campo `estado`, que el Módulo 4 va a actualizar al registrar cobros.
// ============================================================

// ------------------------------------------------------------
// MÉTODO DE CÁLCULO DE HONORARIOS (RN-25)
// PORCENTAJE -> montoBase × porcentaje ÷ 100
// JORNALES   -> cantidadJornales × valorJornal
// MONTO_FIJO -> el monto ingresado tal cual
// ------------------------------------------------------------
enum MetodoHonorarios {
  PORCENTAJE
  JORNALES
  MONTO_FIJO
}

// ------------------------------------------------------------
// TASA DE IVA (RN-28). Confirmado por la abogada 08/10/2026:
// el IVA se SUMA encima del honorario y se elige en los 3 métodos.
// Enum (no número libre) para que la base rechace tasas inventadas.
// ------------------------------------------------------------
enum TasaIva {
  IVA_10    // 10%
  IVA_5     // 5%
  EXENTA    // 0%
}

// ------------------------------------------------------------
// ESTADO DE UNA LIQUIDACIÓN (RF7 / RF10)
// Nace PENDIENTE. El Módulo 4 la pasa a COBRADO_PARCIALMENTE o
// COBRADO al registrar/anular cobros.
// ------------------------------------------------------------
enum EstadoLiquidacion {
  PENDIENTE
  COBRADO_PARCIALMENTE
  COBRADO
}

// ------------------------------------------------------------
// ESTADO DE UN GASTO (RF8 / RF10)
// Igual que la liquidación, más ANULADO (CU-23: "anular un gasto
// cargado por error"). Un gasto ANULADO no cuenta en el saldo.
// ------------------------------------------------------------
enum EstadoGasto {
  PENDIENTE
  COBRADO_PARCIALMENTE
  COBRADO
  ANULADO
}

// ------------------------------------------------------------
// LIQUIDACIÓN DE HONORARIOS
// Una liquidación pertenece a un expediente O a un trámite (RN-26):
// uno de los dos, nunca ambos ni ninguno. Esa regla la valida el
// service (Prisma no tiene CHECK), mismo patrón que DocumentoRecibido.
// Un expediente/trámite puede tener varias liquidaciones (RN-27,
// ej. por etapas).
//
// SNAPSHOT: se guardan los datos de entrada del cálculo (base, %,
// jornales, valor del jornal) y el resultado (neto, IVA, total).
// Así, si mañana cambia el valor del jornal, las liquidaciones ya
// hechas no se modifican.
// onDelete: Restrict = no se puede borrar un expediente/trámite
// que tenga liquidaciones.
// ------------------------------------------------------------
model LiquidacionHonorarios {
  id               Int               @id @default(autoincrement())

  expedienteId     Int?
  expediente       Expediente?       @relation(fields: [expedienteId], references: [id], onDelete: Restrict)
  tramiteId        Int?
  tramite          Tramite?          @relation(fields: [tramiteId], references: [id], onDelete: Restrict)

  metodo           MetodoHonorarios
  concepto         String?           @db.VarChar(200)       // concepto o etapa (ej. "Etapa de demanda"); obligatorio en MONTO_FIJO (lo valida el service)

  // --- Datos de entrada según el método (los que no aplican quedan null) ---
  montoBase        Decimal?          @db.Decimal(15, 2)     // solo PORCENTAJE: monto base del juicio
  porcentaje       Decimal?          @db.Decimal(5, 2)      // solo PORCENTAJE: hasta 999,99 (el service limita a 100)
  cantidadJornales Decimal?          @db.Decimal(8, 2)      // solo JORNALES: admite fracciones (ej. 2,50)
  valorJornal      Decimal?          @db.Decimal(15, 2)     // solo JORNALES: valor del jornal diario al momento de liquidar

  // --- Resultado del cálculo (siempre presente) ---
  tasaIva          TasaIva
  montoNeto        Decimal           @db.Decimal(15, 2)     // honorario antes de IVA (en MONTO_FIJO es el monto ingresado)
  montoIva         Decimal           @db.Decimal(15, 2)     // IVA = neto × tasa (se suma encima)
  montoTotal       Decimal           @db.Decimal(15, 2)     // neto + IVA: lo que se le cobra al cliente

  estado           EstadoLiquidacion @default(PENDIENTE)
  observaciones    String?           @db.VarChar(300)

  creadoEn         DateTime          @default(now())
  actualizadoEn    DateTime          @updatedAt

  @@index([expedienteId])
  @@index([tramiteId])
  @@index([estado])
  @@map("liquidaciones_honorarios")
}

// ------------------------------------------------------------
// GASTO REEMBOLSABLE
// Adelanto de dinero del profesional (tasas, notificaciones, copias,
// viáticos) para reclamar luego al cliente. Se distingue de los
// honorarios y NO lleva IVA (es devolución de lo desembolsado).
// Asociación: expediente O trámite (RN-26), igual que la liquidación.
// El comprobante es un dato referencial: NO se guarda el archivo (RNF 11.5).
// ------------------------------------------------------------
model GastoReembolsable {
  id            Int          @id @default(autoincrement())

  expedienteId  Int?
  expediente    Expediente?  @relation(fields: [expedienteId], references: [id], onDelete: Restrict)
  tramiteId     Int?
  tramite       Tramite?     @relation(fields: [tramiteId], references: [id], onDelete: Restrict)

  concepto      String       @db.VarChar(200)       // ej. "Tasa judicial", "Copias del expediente"
  fecha         DateTime     @db.Date               // día en que se hizo el desembolso (solo fecha, sin hora)
  monto         Decimal      @db.Decimal(15, 2)     // monto desembolsado, en guaraníes
  comprobante   String?      @db.VarChar(100)       // referencia opcional (ej. "Factura 001-001-0001234"); no se guarda el archivo

  estado        EstadoGasto  @default(PENDIENTE)

  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt

  @@index([expedienteId])
  @@index([tramiteId])
  @@index([estado])
  @@map("gastos_reembolsables")
}

// ============================================================
// MÓDULO 4 — COBROS Y RECIBOS (RF10)
// Un recibo (Cobro) registra plata recibida de un cliente. Tiene hasta
// 3 líneas (CobroLinea): honorarios, devolución de gastos y anticipo.
// Las reglas viven en utils/calculoCobros.js y en el service.
// ============================================================

// ------------------------------------------------------------
// MÉTODO DE PAGO. Valores propuestos: la carpeta no los define y
// queda por confirmar con la abogada.
// ------------------------------------------------------------
enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
  OTRO
}

// ------------------------------------------------------------
// ESTADO DE UN RECIBO (RN-35)
// Los recibos NO se eliminan: se anulan y conservan su número.
// ------------------------------------------------------------
enum EstadoCobro {
  EMITIDO
  ANULADO
}

// ------------------------------------------------------------
// TIPO DE LÍNEA DE UN RECIBO (RN-31 / RN-32)
// HONORARIOS -> cobro de honorarios liquidados
// GASTOS     -> devolución de gastos reembolsables
// ANTICIPO   -> pago a cuenta: solo resta del saldo, no se aplica a
//               ninguna liquidación (decisión 16/10/2026)
// ------------------------------------------------------------
enum TipoLineaCobro {
  HONORARIOS
  GASTOS
  ANTICIPO
}

// ------------------------------------------------------------
// COBRO (recibo interno)
// Pertenece a un expediente O a un trámite (RN-31): uno de los dos,
// nunca ambos ni ninguno. Esa regla la valida el service (Prisma no
// tiene CHECK), mismo patrón que LiquidacionHonorarios.
// clienteId se guarda para listar el historial por cliente; el
// service verifica que coincida con el dueño del expediente/trámite.
//
// numero: correlativo desde 1, no se reutiliza (RN-34). @unique
// impide duplicados; el service lo calcula como máximo + 1 dentro de
// la transacción (los anulados cuentan, así el número no se reusa).
//
// onDelete: Restrict = no se puede borrar un expediente, trámite,
// cliente o usuario que tenga recibos.
// ------------------------------------------------------------
model Cobro {
  id               Int          @id @default(autoincrement())
  numero           Int          @unique                  // número de recibo correlativo (RN-34)

  clienteId        Int
  cliente          Cliente      @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  expedienteId     Int?
  expediente       Expediente?  @relation(fields: [expedienteId], references: [id], onDelete: Restrict)
  tramiteId        Int?
  tramite          Tramite?     @relation(fields: [tramiteId], references: [id], onDelete: Restrict)

  fecha            DateTime     @db.Date                 // día del cobro (solo fecha, sin hora); no puede ser futura
  metodoPago       MetodoPago
  referenciaPago   String?      @db.VarChar(100)         // opcional: nº de transferencia o de cheque
  concepto         String?      @db.VarChar(200)         // texto libre del recibo
  estado           EstadoCobro  @default(EMITIDO)

  // Se completan solo al anular (RN-35)
  anuladoEn        DateTime?                             // fecha y hora de la anulación
  motivoAnulacion  String?      @db.VarChar(300)         // obligatorio al anular (lo valida el service)
  anuladoPorId     Int?
  anuladoPor       User?        @relation("CobroAnuladoPor", fields: [anuladoPorId], references: [id], onDelete: Restrict)

  creadoPorId      Int
  creadoPor        User         @relation("CobroCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  creadoEn         DateTime     @default(now())
  actualizadoEn    DateTime     @updatedAt

  lineas           CobroLinea[]

  @@index([clienteId])
  @@index([expedienteId])
  @@index([tramiteId])
  @@index([fecha])
  @@index([estado])
  @@map("cobros")
}

// ------------------------------------------------------------
// LÍNEA DE COBRO: una por tipo dentro de cada recibo (RN-31).
// Que no haya dos líneas del mismo tipo lo garantiza @@unique.
// monto en guaraníes enteros: Decimal(15,2) igual que honorarios
// y gastos (15 dígitos en total, 2 de ellos decimales; el service
// solo acepta enteros).
// onDelete: Restrict = como los recibos no se borran, sus líneas
// tampoco.
// -----------------------------------------------------------
model CobroLinea {
  id        Int            @id @default(autoincrement())
  cobroId   Int
  cobro     Cobro          @relation(fields: [cobroId], references: [id], onDelete: Restrict)

  tipo      TipoLineaCobro
  monto     Decimal        @db.Decimal(15, 2)

  @@unique([cobroId, tipo])
  @@map("cobros_lineas")
}

// ============================================================
// AUDITORÍA (RNF 11.6 / RN-41)
// Registra quién hizo qué y cuándo sobre las operaciones
// relevantes del sistema. Solo consulta para el ABOGADO.
// No tiene relación (FK) con las entidades auditadas a propósito:
// la auditoría debe sobrevivir aunque el registro original
// cambie o se elimine (ej. una plantilla borrada).
// ============================================================

// Qué tipo de operación se realizó
enum AccionAuditoria {
  CREAR
  EDITAR
  INACTIVAR
  REACTIVAR
  ELIMINAR
  BAJA        // baja definitiva de obligación periódica
  COBRAR      // registrar un cobro y emitir su recibo (Módulo 4)
  ANULAR      // anular un gasto (Módulo 3) o un recibo (Módulo 4)
}

model Auditoria {
  id         Int             @id @default(autoincrement())

  // Quién lo hizo. FK real a User: los usuarios nunca se borran (RN-38),
  // así que es seguro y permite mostrar el nombre en la pantalla.
  usuarioId  Int
  usuario    User            @relation(fields: [usuarioId], references: [id])

  accion     AccionAuditoria
  entidad    String          @db.VarChar(50)   // ej: "Cliente", "Expediente" (texto, no enum: crece sin migrar)
  entidadId  Int                                // id del registro afectado (sin FK, ver nota arriba)
  detalle    String?         @db.VarChar(300)   // resumen legible, ej: "García S.A. (RUC 80012345-6)"
  fecha      DateTime        @default(now())    // se completa solo

  @@index([entidad, entidadId])   // acelera "ver historial de este cliente/expediente"
  @@index([fecha])                // acelera ordenar/filtrar por fecha
  @@map("auditoria")
}