// ==========================================
// Módulo 1: Gestión de clientes y expedientes
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------
// TIPO DE CLIENTE
// Enum para distinguir física/jurídica sin usar strings sueltos
// (evita typos como "Fisica" vs "FISICA" en distintas partes del código)
// ------------------------------------------
enum TipoCliente {
  FISICA
  JURIDICA
}

// ------------------------------------------
// TIPO DE ATENCIÓN
// Distingue si el cliente es judicial, extrajudicial, o ambos
// (según el anteproyecto: separar juicios de trámites/asesoría continua)
// ------------------------------------------
enum TipoAtencion {
  JUDICIAL
  EXTRAJUDICIAL
  AMBOS
}

// ------------------------------------------
// FUERO
// Define el área jurisdiccional del expediente.
// Convertido a enum (antes era String libre) porque determina
// qué roles de ParteProcesal son válidos y si aplican
// montoJuicio / unidadFiscal.
// ------------------------------------------
enum Fuero {
  CIVIL_COMERCIAL
  LABORAL
  PENAL
  NINEZ_ADOLESCENCIA
  CONTENCIOSO_ADMINISTRATIVO
  OTRO
}

// ------------------------------------------
// ESTADO PROCESAL
// Situación actual del expediente dentro del proceso judicial.
// Es enum (no texto libre) para evitar variantes como
// "En trámite" / "en tramite" que romperían los filtros.
// Agregar un valor nuevo a futuro = una migración chica.
// ------------------------------------------
enum EstadoProcesal {
  EN_TRAMITE
  EN_APELACION
  SUSPENDIDO
  ARCHIVADO
  CONCLUIDO
}

// ------------------------------------------
// ROL DE PARTE PROCESAL
// Categorías amplias y estables, independientes del fuero.
// El matiz exacto (Actor, Imputado, Víctima...) va en
// ParteProcesal.rolEspecifico como texto libre.
// ------------------------------------------
enum RolParte {
  ACTOR                   // actor / demandante / solicitante / denunciante / víctima
  DEMANDADO               // demandado / imputado / acusado
  TERCERO                 // tercero / citado en garantía / querellante adhesivo
  REPRESENTANTE_ESTATAL   // agente fiscal (Ministerio Público)
  DEFENSA                 // defensor técnico (privado o público)
}

// ------------------------------------------
// CLIENTE (tabla base)
// Contiene los datos comunes a persona física y jurídica.
// Las extensiones (ClientePersonaFisica / ClientePersonaJuridica)
// cuelgan de esta tabla en relación 1:1.
// ------------------------------------------
model Cliente {
  id              Int           @id @default(autoincrement())
  ruc             String        @unique // RUC: en física es cédula + dígito verificador, en jurídica es el RUC societario
  tipo            TipoCliente
  nombreRazonSocial String      // nombre completo (física) o razón social (jurídica)
  tipoAtencion    TipoAtencion  @default(JUDICIAL)
  email           String?
  telefono        String?
  direccion       String?
  activo          Boolean       @default(true) // permite "dar de baja" sin borrar el historial
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relaciones 1:1 con las extensiones (una y solo una debe existir según 'tipo')
  personaFisica   ClientePersonaFisica?
  personaJuridica ClientePersonaJuridica?

  // Relación 1:N: un cliente puede tener muchos expedientes
  expedientes     Expediente[]
  partesProcesales ParteProcesal[]  // NUEVO: casos donde este cliente es parte de un expediente (propio o ajeno)

  @@map("clientes") // nombre real de la tabla en PostgreSQL (snake_case, convención SQL)
}

// ------------------------------------------
// EXTENSIÓN: PERSONA FÍSICA
// Datos exclusivos de clientes persona física.
// clienteId es a la vez FK y PK: garantiza la relación 1:1
// (un Cliente no puede tener dos registros de PersonaFisica)
// ------------------------------------------
model ClientePersonaFisica {
  clienteId               Int      @id
  cliente                 Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  cedula                  String   @unique
  digitoVerificador       Int      // dígito verificador del RUC, define condiciones (ej. vencimientos)
  fechaNacimiento          DateTime?

  @@map("clientes_persona_fisica")
}

// ------------------------------------------
// EXTENSIÓN: PERSONA JURÍDICA
// Datos básicos por ahora (según alcance actual).
// A futuro: representantes, actas de asamblea, estatutos, libro de acciones
// (mencionado por la clienta pero fuera del alcance de esta versión).
// ------------------------------------------
model ClientePersonaJuridica {
  clienteId         Int      @id
  cliente           Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  tipoSocietario    String   // ej. "SA", "SRL", "Fundación" — texto libre por ahora, no enum (puede variar mucho)
  fechaConstitucion DateTime?
  representanteLegal String? // NUEVO: quien representa a la empresa en general. Texto simple y opcional; si a futuro se necesita como entidad (con CI, poder, etc.), se migra a tabla propia.

  @@map("clientes_persona_juridica")
}

// ------------------------------------------
// EXPEDIENTE
// Registro de casos judiciales y extrajudiciales.
// El monto del juicio es opcional porque no todo expediente lo tiene
// (ej. trámites o asesorías sin monto litigioso definido).
//
// IDENTIFICACIÓN ÚNICA (regla de negocio validada con la abogada):
// en Paraguay el número de expediente NO es único por sí solo:
// la numeración reinicia cada año y un expediente puede trasladarse
// a otro juzgado. Por eso se identifica por la combinación
// número + año + juzgado + carátula (ver @@unique al final).
// ------------------------------------------
model Expediente {
  id              Int       @id @default(autoincrement())
  clienteId       Int
  cliente         Cliente   @relation(fields: [clienteId], references: [id])

  numeroExpediente String   // ya NO es @unique solo: la unicidad es compuesta (ver abajo)
  anio            Int       // NUEVO: año del expediente (la numeración reinicia cada año). Ej: 2024
  caratula        String
  fuero           Fuero?
  jurisdiccion    String?
  juzgado         String    // CAMBIO: ahora obligatorio. Sin juzgado no se puede validar duplicados.
  secretaria      String?   // Secretaría del juzgado (ej. "Secretaría N°1")
  objetoJuicio    String?   // descripción breve del tipo de proceso (ej. "Cobro de Guaraníes", "Sucesión Intestada")
  montoJuicio     Decimal?  @db.Decimal(15, 2) // 15 dígitos en total, 2 decimales. Opcional: no aplica en fueros como Penal
  unidadFiscal    String?   // exclusivo de fuero Penal (ej. "Unidad Penal N°5"). Null en otros fueros.
  estadoProcesal  EstadoProcesal @default(EN_TRAMITE) // NUEVO: situación procesal actual

  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relación 1:N con las partes procesales del expediente
  partes          ParteProcesal[]

  // Unicidad compuesta: mismo número + año + juzgado + carátula = duplicado.
  // Si cambia cualquiera de los cuatro, se considera un expediente distinto.
  @@unique([numeroExpediente, anio, juzgado, caratula])

  @@map("expedientes")
}

// ------------------------------------------
// PARTE PROCESAL
// Representa a cada sujeto involucrado en un expediente.
// Puede o no estar vinculada a un Cliente existente:
// si la parte contraria no es cliente del estudio,
// clienteId queda null y se guardan nombre/documento sueltos.
// ------------------------------------------
model ParteProcesal {
  id              Int         @id @default(autoincrement())

  expedienteId    Int
  expediente      Expediente  @relation(fields: [expedienteId], references: [id], onDelete: Cascade)

  // Vínculo opcional: si esta parte ya es Cliente del estudio, se conecta acá
  clienteId       Int?
  cliente         Cliente?    @relation(fields: [clienteId], references: [id])

  // Datos propios de la parte (se completan siempre, sea o no Cliente)
  nombre          String
  documento       String?     // CI/RUC del tercero; puede ser null si no se conoce aún

  rol             RolParte    // categoría amplia (ACTOR, DEMANDADO, etc.)
  rolEspecifico   String?     // etiqueta exacta según fuero (ej. "Imputado", "Víctima", "Actor")

  createdAt       DateTime    @default(now())

  @@map("partes_procesales")
}

// ------------------------------------------
// ROL DE USUARIO
// Define el nivel de acceso dentro del sistema.
// ABOGADO: acceso total (crear/editar/eliminar en todos los módulos).
// ASISTENTE: por ahora solo lectura + reportes (se resuelve en el
// middleware de autorización, no acá — así cambiar permisos más
// adelante no requiere tocar el schema ni migrar la DB).
// ------------------------------------------
enum RolUsuario {
  ABOGADO
  ASISTENTE
}

// ------------------------------------------
// USER (Usuario del sistema)
// No hay auto-registro público: los usuarios se crean vía script
// de seed, porque este sistema es de uso interno y cerrado
// (una abogada + su asistente), no una app con altas públicas.
// ------------------------------------------
model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String     // nunca se guarda la contraseña en texto plano, solo su hash (bcrypt)
  nombre       String
  rol          RolUsuario @default(ASISTENTE)
  activo       Boolean    @default(true) // permite desactivar acceso sin borrar el historial de quién hizo qué
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("users")
}

// ============================================================
// MÓDULO 1.4 — BIBLIOTECA DE ESCRITOS FORENSES
// Plantillas de escritos que se van "catastrando" de a poco.
// Cuerpo en texto plano (sin variables). Hard-delete (sin campo activo).
// ============================================================

// Clasificación de primer nivel, como la organiza la abogada
enum ClaseEscrito {
  DE_FONDO          // escritos principales: demanda, excepción, contestación
  DE_MERO_TRAMITE   // impulso, oficios, denuncias, etc.
}

// Tipo específico de escrito
enum CategoriaEscrito {
  DEMANDA
  CONTESTACION
  EXCEPCION
  RECURSO
  IMPULSO_PROCESAL
  SOLICITUD_OFICIO
  DENUNCIA
  MEDIACION
  MEDIDA_CAUTELAR
  OTRO
}

// De dónde salió el texto (trazabilidad: propia, generada con IA u otro)
enum OrigenPlantilla {
  PROPIA
  IA
  OTRO
}

model PlantillaEscrito {
  id            Int              @id @default(autoincrement())
  titulo        String           @db.VarChar(200)   // nombre visible en la lista
  descripcion   String?          @db.VarChar(300)   // resumen corto (opcional)
  contenido     String           @db.Text           // cuerpo completo del escrito (texto plano, sin límite práctico)

  fuero         Fuero?                              // reutiliza el enum existente; opcional (hay escritos válidos para cualquier fuero)
  clase         ClaseEscrito                        // obligatoria: de fondo o de mero trámite
  categoria     CategoriaEscrito                    // obligatoria: tipo específico
  origen        OrigenPlantilla  @default(PROPIA)   // por defecto se asume propia

  creadoEn      DateTime         @default(now())    // se completa solo al crear
  actualizadoEn DateTime         @updatedAt         // Prisma lo actualiza solo en cada edición

  @@index([fuero, clase, categoria])                // acelera los filtros combinados de la pantalla
}