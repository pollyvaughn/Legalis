# ============================================================
# Variables de entorno del backend
# Copiá este archivo como ".env" y completá los valores.
# El archivo ".env" NO se sube a git (tiene secretos).
# ============================================================

# Conexión a PostgreSQL:
# postgresql://USUARIO:CONTRASEÑA@localhost:5432/NOMBRE_DE_LA_BASE
DATABASE_URL=postgresql://TU_USUARIO:TU_CONTRASEÑA@localhost:5432/asesoria_db

# Puerto del servidor Express (el frontend debe apuntar a este puerto)
PORT=3000

# Secreto para firmar los tokens de sesión (JWT).
# Generá uno aleatorio con este comando y pegalo acá:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=